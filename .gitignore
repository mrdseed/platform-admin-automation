crash.log
crash.*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Checkov / security scan output
checkov-results.sarif
*.sarif

# SSH keys
*.pem
id_rsa*
*.ppk
